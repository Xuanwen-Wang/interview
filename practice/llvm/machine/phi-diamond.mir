# Original pre-RA fixture: incoming PHI uses belong to control-flow edges.
---
name: phi_diamond
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rdi, $rsi, $edx
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    %2:gr32 = COPY $edx
    TEST32rr %2, %2, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1
  bb.1:
    successors: %bb.3
    %3:gr64 = XOR64rr %0, %1, implicit-def dead $eflags
    JMP_1 %bb.3
  bb.2:
    successors: %bb.3
    %4:gr64 = AND64rr %0, %1, implicit-def dead $eflags
    JMP_1 %bb.3
  bb.3:
    %5:gr64 = PHI %3, %bb.1, %4, %bb.2
    $rax = COPY %5
    RET 0, $rax
...
